{
  "$comment": "Shared conformance cases. The Node and Python implementations both run every case here; change behaviour here first.",
  "envName": [
    { "key": "DB_PASSWORD", "mode": "auto", "expect": "DB_PASSWORD" },
    { "key": "db.password", "mode": "auto", "expect": "DB_PASSWORD" },
    { "key": "spring.datasource.url", "mode": "auto", "expect": "SPRING_DATASOURCE_URL" },
    { "key": "database_url", "mode": "auto", "expect": "database_url" },
    { "key": "api-key", "mode": "auto", "expect": "API_KEY" },
    { "key": "9lives", "mode": "auto", "expect": "_9LIVES" },
    { "key": "a b/c", "mode": "auto", "expect": "A_B_C" },
    { "key": "DB_PASSWORD", "mode": "verbatim", "expect": "DB_PASSWORD" },
    { "key": "db.password", "mode": "verbatim", "expect": "db.password" },
    { "key": "database_url", "mode": "verbatim", "expect": "database_url" },
    { "key": "db.password", "mode": "upper", "expect": "DB_PASSWORD" },
    { "key": "database_url", "mode": "upper", "expect": "DATABASE_URL" },
    { "key": "camelCase", "mode": "upper", "expect": "CAMELCASE" }
  ],
  "mapEntries": [
    { "name": "prefix applied after mapping", "data": { "host": "h", "db.port": "5432" }, "prefix": "PG_", "mode": "auto",
      "expect": { "PG_host": "h", "PG_DB_PORT": "5432" } },
    { "name": "non-string values become JSON", "data": { "n": 5, "b": true, "o": { "a": 1 }, "z": null }, "prefix": "", "mode": "auto",
      "expect": { "n": "5", "b": "true", "o": "{\"a\":1}", "z": "" } },
    { "name": "dot and dash collide", "data": { "db.password": "x", "db-password": "y" }, "prefix": "", "mode": "auto",
      "error": "collision" },
    { "name": "auto keeps valid names, so case differs only", "data": { "database_url": "x", "DATABASE_URL": "y" }, "prefix": "", "mode": "auto",
      "expect": { "database_url": "x", "DATABASE_URL": "y" } },
    { "name": "same case-different names collide where names are case-insensitive", "data": { "database_url": "x", "DATABASE_URL": "y" }, "prefix": "", "mode": "auto",
      "caseInsensitive": true, "error": "collision" },
    { "name": "upper makes them collide", "data": { "database_url": "x", "DATABASE_URL": "y" }, "prefix": "", "mode": "upper",
      "error": "collision" },
    { "name": "verbatim rejects '=' in a key", "data": { "a=b": "x" }, "prefix": "", "mode": "verbatim",
      "error": "value" },
    { "name": "NUL in a value", "data": { "k": "a\u0000b" }, "prefix": "", "mode": "auto",
      "error": "value" }
  ],
  "merge": [
    { "name": "later import wins", "imports": [{ "A": "1", "B": "1" }, { "B": "2" }],
      "expect": { "A": "1", "B": "2" }, "overridden": ["B"] },
    { "name": "case-insensitive later import wins and keeps its own spelling", "caseInsensitive": true, "imports": [{ "db_url": "1" }, { "DB_URL": "2" }],
      "expect": { "DB_URL": "2" }, "overridden": ["DB_URL"] }
  ],
  "plan": [
    { "name": "existing variables win by default", "values": { "A": "vault", "B": "vault" }, "env": { "A": "local" }, "override": false,
      "set": { "B": "vault" }, "kept": ["A"] },
    { "name": "override replaces them", "values": { "A": "vault", "B": "vault" }, "env": { "A": "local" }, "override": true,
      "set": { "A": "vault", "B": "vault" }, "kept": [] },
    { "name": "an empty existing value still counts as set", "values": { "A": "vault" }, "env": { "A": "" }, "override": false,
      "set": {}, "kept": ["A"] }
  ],
  "parseImport": [
    { "raw": "database", "expect": { "optional": false, "kind": "relative", "path": "database", "prefix": "", "name": "auto" } },
    { "raw": "optional:feature-flags", "expect": { "optional": true, "kind": "relative", "path": "feature-flags" } },
    { "raw": "vault://secret/order-service/prod/db", "expect": { "kind": "absolute", "path": "secret/order-service/prod/db" } },
    { "raw": "vault://", "expect": { "kind": "base", "path": "" } },
    { "raw": "redis?prefix=REDIS_&name=upper&kv=1", "expect": { "path": "redis", "prefix": "REDIS_", "name": "upper", "kv": 1 } },
    { "raw": "nested/coll/", "expect": { "path": "nested/coll" } },
    { "raw": "x?name=snake", "error": "config" },
    { "raw": "x?kv=3", "error": "config" },
    { "raw": "x?color=red", "error": "config" },
    { "raw": "x?prefix=BAD-", "error": "config" },
    { "raw": "../etc", "error": "config" },
    { "raw": "a//b", "error": "config" },
    { "raw": "vault://secret", "error": "config" },
    { "raw": "https://example.com/x", "error": "config" }
  ],
  "authSelection": [
    { "$comment": "Every case also sets VAULT_ADDR=https://vault.example.com and VAULT_ENV_IMPORT=db. \"<file:x>\" is a temporary file containing x. used = the variables removed from the command's environment after loading." },
    { "name": "a token alone: token authentication, as in 0.1", "env": { "VAULT_TOKEN": "t" }, "expect": { "auth": "token", "used": [], "ignoredNote": false } },
    { "name": "a token wins over AppRole and leaves its variables alone", "env": { "VAULT_TOKEN": "t", "VAULT_ROLE_ID": "r", "VAULT_SECRET_ID": "s" }, "expect": { "auth": "token", "used": [], "ignoredNote": true } },
    { "name": "a token file wins too", "env": { "VAULT_TOKEN_FILE": "<file:t>", "VAULT_ROLE_ID": "r" }, "expect": { "auth": "token", "used": [], "ignoredNote": true } },
    { "name": "AppRole from variables", "env": { "VAULT_ROLE_ID": "r", "VAULT_SECRET_ID": "s" }, "expect": { "auth": "approle", "roleId": "r", "secretId": "s", "mount": "approle", "used": ["VAULT_ROLE_ID", "VAULT_SECRET_ID"], "ignoredNote": false } },
    { "name": "AppRole from files", "env": { "VAULT_ROLE_ID_FILE": "<file:r>", "VAULT_SECRET_ID_FILE": "<file:s>" }, "expect": { "auth": "approle", "roleId": "r", "secretId": "s", "used": ["VAULT_ROLE_ID_FILE", "VAULT_SECRET_ID_FILE"] } },
    { "name": "a variable beats its file, and the unused file variable is kept", "env": { "VAULT_ROLE_ID": "r", "VAULT_ROLE_ID_FILE": "<file:other>", "VAULT_SECRET_ID": "s" }, "expect": { "auth": "approle", "roleId": "r", "secretId": "s", "used": ["VAULT_ROLE_ID", "VAULT_SECRET_ID"] } },
    { "name": "a role ID alone (a role without bind_secret_id)", "env": { "VAULT_ROLE_ID": "r" }, "expect": { "auth": "approle", "roleId": "r", "secretId": null, "used": ["VAULT_ROLE_ID"] } },
    { "name": "another mount", "env": { "VAULT_ROLE_ID": "r", "VAULT_SECRET_ID": "s", "VAULT_ENV_APPROLE_MOUNT": "ci/approle" }, "expect": { "auth": "approle", "mount": "ci/approle" } },
    { "name": "a secret ID without a role ID", "env": { "VAULT_SECRET_ID": "s" }, "error": "config" },
    { "name": "no credentials at all", "env": {}, "error": "config" },
    { "name": "an empty role ID file", "env": { "VAULT_ROLE_ID_FILE": "<file:>" }, "error": "config" },
    { "name": "a mount path that is not one", "env": { "VAULT_ROLE_ID": "r", "VAULT_SECRET_ID": "s", "VAULT_ENV_APPROLE_MOUNT": "../sys" }, "error": "config" }
  ]
}
